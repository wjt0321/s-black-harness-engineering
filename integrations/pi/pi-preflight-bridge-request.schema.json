{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-black-harness-engineering.local/schemas/pi-preflight-bridge-request.schema.json",
  "title": "Pi Host Preflight Bridge Request",
  "type": "object",
  "required": ["schema_version", "tool", "input"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pi-bridge/preflight-request/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tool": {
      "type": "string",
      "enum": ["read", "write", "edit", "bash"]
    },
    "input": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "tool": { "const": "read" } } },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "tool": { "const": "write" } } },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["path", "content"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "content": { "type": "string", "minLength": 1, "maxLength": 49152 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "tool": { "const": "edit" } } },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["path", "edits"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "edits": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": ["old_string", "new_string"],
                  "additionalProperties": false,
                  "properties": {
                    "old_string": { "type": "string", "minLength": 1, "maxLength": 49152 },
                    "new_string": { "type": "string", "minLength": 1, "maxLength": 49152 }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "tool": { "const": "bash" } } },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "required": ["command"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    }
  ]
}
