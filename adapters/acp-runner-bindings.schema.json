{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.local/schemas/acp-runner-bindings.schema.json",
  "title": "ACP Socket Runner Bindings",
  "type": "object",
  "required": ["version", "bindings"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["socket_id", "runner_id"],
        "additionalProperties": false,
        "properties": {
          "socket_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
          "runner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,127}$"}
        }
      }
    }
  }
}
