{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-plane/external-agent-single-work-item-result/v2",
  "title": "外部智能体单工作项宿主结果",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contract", "request_id", "target_profile", "status", "completed_at", "events", "artifacts"],
  "properties": {
    "version": {"const": 2},
    "contract": {"const": "external-agent-single-work-item-result/v2"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "target_profile": {"enum": ["pi-local", "omp-local"]},
    "status": {"enum": ["succeeded", "blocked", "failed", "timed_out", "cancelled"]},
    "completed_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "failure_code": {"$ref": "#/$defs/failure_code"},
    "output": {"type": "string", "minLength": 1, "maxLength": 32768, "pattern": "^[^\\u0000]+$"},
    "output_bytes": {"type": "integer", "minimum": 1, "maximum": 32768},
    "output_digest": {"$ref": "#/$defs/hash"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "event_type", "occurred_at"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 8},
          "event_type": {
            "enum": [
              "request_claimed", "host_turn_dispatched", "host_turn_started", "host_turn_completed",
              "host_turn_blocked", "host_turn_timed_out", "host_session_closed"
            ]
          },
          "occurred_at": {"type": "string", "minLength": 20, "maxLength": 40},
          "failure_code": {"$ref": "#/$defs/failure_code"}
        }
      }
    },
    "artifacts": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failure_code": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9][a-z0-9-]*$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"required": ["output", "output_bytes", "output_digest"], "not": {"required": ["failure_code"]}},
      "else": {"required": ["failure_code"], "not": {"anyOf": [{"required": ["output"]}, {"required": ["output_bytes"]}, {"required": ["output_digest"]}]}}
    }
  ]
}
