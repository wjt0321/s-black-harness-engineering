{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-plane/external-agent-evidence-manifest/v1",
  "title": "外部智能体不可变执行证据清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract",
    "attempt_id",
    "task_id",
    "request_id",
    "collaboration_file",
    "collaboration_plan_id",
    "work_item_id",
    "target_profile",
    "plan_hash",
    "approval_binding_id",
    "execution_status",
    "completed_at",
    "host_events",
    "artifact",
    "expected_artifact_types",
    "review"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "contract": {
      "const": "external-agent-evidence-manifest/v1"
    },
    "attempt_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "collaboration_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n]+\\.json$"
    },
    "collaboration_plan_id": {
      "$ref": "#/$defs/hash"
    },
    "work_item_id": {
      "$ref": "#/$defs/identifier"
    },
    "target_profile": {
      "enum": [
        "pi-local",
        "omp-local"
      ]
    },
    "plan_hash": {
      "$ref": "#/$defs/hash"
    },
    "approval_binding_id": {
      "$ref": "#/$defs/hash"
    },
    "execution_status": {
      "const": "succeeded"
    },
    "completed_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "host_events": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_type",
          "occurred_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "event_type": {
            "enum": [
              "request_claimed",
              "host_turn_dispatched",
              "host_turn_started",
              "host_turn_completed",
              "host_turn_blocked",
              "host_turn_timed_out",
              "host_session_closed"
            ]
          },
          "occurred_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          },
          "failure_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "media_type",
        "content_hash",
        "byte_count",
        "relative_path"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_type": {
          "enum": [
            "analysis",
            "plan",
            "draft",
            "patch",
            "test_result",
            "review",
            "summary",
            "execution_result"
          ]
        },
        "media_type": {
          "enum": [
            "text/plain",
            "application/json"
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^\\.runtime/external-agent-evidence/v1/artifacts/[a-f0-9]{64}\\.(txt|json)$"
        }
      }
    },
    "expected_artifact_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "analysis",
          "plan",
          "draft",
          "patch",
          "test_result",
          "review",
          "summary"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "gate_id",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "gate_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "status": {
          "enum": [
            "not_required",
            "pending"
          ]
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
